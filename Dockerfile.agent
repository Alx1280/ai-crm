# Stage 1: Dependencies and Turbo
FROM oven/bun:1.3-slim AS base
WORKDIR /app
COPY . .
# prisma generate runs during install (postinstall of @crm/db) and loads
# prisma.config.ts, which requires DATABASE_URL to be resolvable. It does not
# connect, so a placeholder is fine here.
ENV DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm
RUN bun install --frozen-lockfile

# Stage 2: Build the Agent (eve)
# `eve build` evaluates the authored modules, and @crm/db throws unless
# DATABASE_URL is set (even though nothing connects at build time).
FROM base AS builder
WORKDIR /app
ARG DATABASE_URL
ENV DATABASE_URL=$DATABASE_URL
RUN bun run build --filter=agent

# Stage 3: Runtime image for Agent
# Copy the whole workspace tree: bun nests workspace symlinks per-app
# (apps/agent/node_modules/@crm/* -> ../../../../packages/*), so root node_modules
# alone is not enough for @crm/db and @crm/env to resolve.
FROM oven/bun:1.3-slim
WORKDIR /app
COPY --from=builder /app ./

ENV NODE_ENV=production
EXPOSE 2000
WORKDIR /app/apps/agent
CMD ["bun", "run", "start", "--host", "0.0.0.0"]
