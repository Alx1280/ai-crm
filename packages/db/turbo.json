{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"inputs": ["$TURBO_DEFAULT$", "prisma/**"],
			"outputs": ["src/generated/**"],
			"passThroughEnv": ["DATABASE_URL"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": ["DATABASE_URL"]
		},
		"db:generate": {
			"inputs": ["$TURBO_DEFAULT$", "prisma/**"],
			"outputs": ["src/generated/**"],
			"passThroughEnv": ["DATABASE_URL"]
		},
		"db:deploy": {
			"cache": false,
			"passThroughEnv": ["DATABASE_URL"]
		},
		"db:migrate": {
			"cache": false,
			"interactive": true,
			"passThroughEnv": ["DATABASE_URL"]
		},
		"db:push": {
			"cache": false,
			"interactive": true,
			"passThroughEnv": ["DATABASE_URL"]
		},
		"db:reset": {
			"cache": false,
			"interactive": true,
			"passThroughEnv": ["DATABASE_URL"]
		},
		"db:seed": {
			"cache": false,
			"passThroughEnv": ["BLOB_READ_WRITE_TOKEN", "DATABASE_URL"]
		},
		"db:studio": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": ["DATABASE_URL"]
		},
		"check-types": {
			"dependsOn": ["$TURBO_EXTENDS$", "build"],
			"passThroughEnv": ["DATABASE_URL"]
		}
	}
}
